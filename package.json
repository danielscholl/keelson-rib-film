{
  "name": "@keelson/rib-film",
  "version": "0.1.1",
  "description": "Keelson rib for narrated short films: a storyboard you approve, a cut the line renders, notes turned into revisions, and a publish step, run by agents on any provider.",
  "license": "Apache-2.0",
  "author": "Daniel Scholl",
  "homepage": "https://github.com/danielscholl/keelson-rib-film#readme",
  "bugs": {
    "url": "https://github.com/danielscholl/keelson-rib-film/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielscholl/keelson-rib-film.git"
  },
  "keywords": [
    "keelson",
    "rib",
    "video",
    "film",
    "narration"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "method",
    "tools",
    "starter",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "link:keelson": "bun dev/link.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@keelson/shared": "https://github.com/danielscholl/keelson/releases/download/v0.128.0/keelson-shared.tgz",
    "@types/bun": "^1.1.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@keelson/shared": ">=0.127.0"
  },
  "peerDependenciesMeta": {
    "@keelson/shared": {
      "optional": true
    }
  }
}
